rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isTeacherOfStudent(studentDoc) {
      // Student doc must have a denormalized teacherIds array populated server-side
      // when the student joins a teacher's class.
      return isSignedIn()
          && 'teacherIds' in studentDoc.data
          && studentDoc.data.teacherIds is list
          && request.auth.uid in studentDoc.data.teacherIds;
    }

    // ─── Students Collection ────────────────────────────────────────
    match /students/{studentId} {
      allow read: if isOwner(studentId)
                  || isTeacherOfStudent(resource);

      // Allow create with restricted initial values
      allow create: if isOwner(studentId)
                    && request.resource.data.xp == 0
                    && request.resource.data.quizScore == 0
                    && request.resource.data.streak == 0
                    && request.resource.data.keys().hasAll(['email', 'displayName', 'xp', 'quizScore', 'streak']);

      // Only server (admin SDK) updates XP/scores/level/role/teacherIds.
      // Client can update non-sensitive profile fields only.
      allow update: if isOwner(studentId)
                    && (!request.resource.data.diff(resource.data).affectedKeys()
                        .hasAny(['xp', 'quizScore', 'level', 'role', 'teacherIds']));
    }

    // ─── Teachers Collection ────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId);
      allow write: if false; // Admin SDK only
    }

    // ─── Classes Collection ─────────────────────────────────────────
    match /classes/{classId} {
      allow read: if isSignedIn()
                  && (resource.data.teacherId == request.auth.uid
                      || request.auth.uid in resource.data.studentIds);

      allow write: if false; // Admin SDK only (via API routes)
    }

    // ─── Duels Collection ───────────────────────────────────────────
    match /duels/{matchId} {
      // Allow reading waiting duels (to join) or matches user participates in
      allow read: if isSignedIn()
                  && (resource.data.status == 'waiting'
                      || resource.data.player1.uid == request.auth.uid
                      || ('player2' in resource.data && resource.data.player2.uid == request.auth.uid));

      // Allow creating a waiting duel where creator is player1
      allow create: if isSignedIn()
                    && request.resource.data.player1.uid == request.auth.uid
                    && request.resource.data.status == 'waiting'
                    && !('player2' in request.resource.data)
                    && request.resource.data.player1.score == 0
                    && request.resource.data.player1.finished == false;

      // Allow first-time join OR in-progress update by an authorized participant
      allow update: if isSignedIn()
                    && (isJoiningDuel() || isParticipantUpdate());
    }

    // ─── Duel Helper Functions ──────────────────────────────────────
    function isJoiningDuel() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == 'waiting'
          && !('player2' in resource.data)
          && request.resource.data.status == 'playing'
          && request.resource.data.player2.uid == request.auth.uid
          && request.resource.data.player1.uid != request.auth.uid
          && request.resource.data.player2.score == 0
          && request.resource.data.player2.finished == false
          && request.resource.data.player1 == resource.data.player1
          && affected.hasOnly(['player2', 'status']);
    }

    function isParticipantUpdate() {
      return isPlayer1Update() || isPlayer2Update();
    }

    function isPlayer1Update() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.player1.uid == request.auth.uid
          && affected.hasOnly(['player1', 'status'])
          // Player 2 data must remain completely untouched
          && (!('player2' in resource.data) || request.resource.data.player2 == resource.data.player2)
          // Player 1 identity immutable
          && request.resource.data.player1.uid == resource.data.player1.uid
          && request.resource.data.player1.displayName == resource.data.player1.displayName
          // Status can only remain same or transition to finished if both players are finished
          && (request.resource.data.status == resource.data.status
              || (request.resource.data.status == 'finished'
                  && request.resource.data.player1.finished == true
                  && 'player2' in resource.data
                  && resource.data.player2.finished == true));
    }

    function isPlayer2Update() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return 'player2' in resource.data
          && resource.data.player2.uid == request.auth.uid
          && affected.hasOnly(['player2', 'status'])
          // Player 1 data must remain completely untouched
          && request.resource.data.player1 == resource.data.player1
          // Player 2 identity immutable
          && request.resource.data.player2.uid == resource.data.player2.uid
          && request.resource.data.player2.displayName == resource.data.player2.displayName
          // Status can only remain same or transition to finished if both players are finished
          && (request.resource.data.status == resource.data.status
              || (request.resource.data.status == 'finished'
                  && request.resource.data.player2.finished == true
                  && resource.data.player1.finished == true));
    }

    // ─── Catch-all: Deny everything else ────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
