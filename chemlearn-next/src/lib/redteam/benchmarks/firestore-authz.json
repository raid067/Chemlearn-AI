[
  {
    "id": "fs-s2s-001",
    "category": "firestore-authz",
    "name": "Student A Modifies Student B Profile",
    "description": "Student attempts to write or update another student's document in /students/{targetUid}.",
    "severity": "CRITICAL",
    "input": {
      "collection": "students",
      "callerUid": "student_alice_001",
      "targetDocId": "student_bob_002",
      "operation": "update",
      "payload": { "displayName": "Hacked Bob" }
    },
    "expectedBehavior": "DENIED (isOwner check fails: callerUid != targetDocId)",
    "assertions": {
      "type": "denied"
    }
  },
  {
    "id": "fs-s2s-002",
    "category": "firestore-authz",
    "name": "Student A Deletes Student B Document",
    "description": "Student attempts to execute delete on another student's record.",
    "severity": "CRITICAL",
    "input": {
      "collection": "students",
      "callerUid": "student_alice_001",
      "targetDocId": "student_bob_002",
      "operation": "delete"
    },
    "expectedBehavior": "DENIED (only the owner or admin can delete)",
    "assertions": {
      "type": "denied"
    }
  },
  {
    "id": "fs-s2t-001",
    "category": "firestore-authz",
    "name": "Student Escalates Role to Teacher / Admin",
    "description": "Student updates their own user profile to inject role: 'teacher' or admin: true.",
    "severity": "CRITICAL",
    "input": {
      "collection": "users",
      "callerUid": "student_alice_001",
      "targetDocId": "student_alice_001",
      "operation": "update",
      "payload": { "role": "teacher", "admin": true }
    },
    "expectedBehavior": "DENIED (validUserUpdate strictly prohibits 'role' or 'admin' in affectedKeys)",
    "assertions": {
      "type": "denied"
    }
  },
