rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isTeacherOfStudent(studentDoc) {
      return isAuthenticated()
          && 'teacherIds' in studentDoc.data
          && studentDoc.data.teacherIds is list
          && request.auth.uid in studentDoc.data.teacherIds;
    }

    // Strict field whitelist + type guards prevent mass-assignment attacks
    function validStudentCreate() {
      let data = request.resource.data;
      let allowedKeys = ['email', 'displayName', 'xp', 'quizScore', 'streak', 'createdAt', 'teacherIds'];
      return data.keys().hasOnly(allowedKeys)
          && data.email is string
          && data.email.size() <= 150
          && data.displayName is string
          && data.displayName.size() <= 100
          && data.xp == 0
          && data.quizScore == 0
          && data.streak == 0
          && (!('teacherIds' in data) || (data.teacherIds is list && data.teacherIds.size() == 0));
    }

    // Updates: only safe client-visible fields; xp/quizScore/teacherIds only via server Admin SDK
    function validStudentUpdate() {
      let affectedKeys = request.resource.data.diff(resource.data).affectedKeys();
      let allowedUpdateKeys = ['displayName', 'streak', 'lastSeen', 'updatedAt'];
      return affectedKeys.hasOnly(allowedUpdateKeys)
          && (!affectedKeys.hasAny(['displayName']) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
          && (!affectedKeys.hasAny(['streak']) || (request.resource.data.streak is int && request.resource.data.streak >= 0 && request.resource.data.streak <= 10000))
          && (!affectedKeys.hasAny(['xp', 'quizScore', 'level', 'role', 'teacherIds']));
    }

    // User Profile Whitelist
    function validUserCreate() {
      let data = request.resource.data;
      let allowedKeys = ['uid', 'email', 'displayName', 'photoURL', 'avatarUrl', 'role', 'createdAt', 'updatedAt', 'preferences'];
      return data.keys().hasOnly(allowedKeys)
          && (!('role' in data) || data.role == 'student')
          && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100));
    }

    function validUserUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      let allowedUpdateKeys = ['displayName', 'photoURL', 'avatarUrl', 'preferences', 'updatedAt'];
      return affected.hasOnly(allowedUpdateKeys)
          && (!affected.hasAny(['displayName']) || (request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100))
          && (!affected.hasAny(['role', 'admin', 'xp', 'level', 'streak', 'email', 'uid']));
    }

    // Chat History Whitelist and Bounds
    function validChatHistory() {
      let data = request.resource.data;
      let allowedKeys = ['id', 'title', 'messages', 'question', 'answer', 'timestamp', 'createdAt', 'updatedAt'];
      return data.keys().hasOnly(allowedKeys)
          && (!('title' in data) || (data.title is string && data.title.size() <= 200))
          && (!('question' in data) || (data.question is string && data.question.size() <= 4000))
          && (!('answer' in data) || (data.answer is string && data.answer.size() <= 10000))
          && (!('messages' in data) || (data.messages is list && data.messages.size() <= 100));
    }

    // ── Server-Only Collections (Admin SDK Exclusive) ─────────────────────────
    match /server_quizzes/{document=**} {
      allow read, write: if false;
    }

    match /server_duels/{document=**} {
      allow read, write: if false;
    }

    match /xp_events/{document=**} {
      allow read, write: if false;
    }

    match /ai_usage/{document=**} {
      allow read, write: if false;
    }

    // ── Admin System Stats ────────────────────────────────────────────────────
    match /system_stats/{document=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Feedbacks ─────────────────────────────────────────────────────────────
    match /feedbacks/{feedbackId} {
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['uid', 'userName', 'text', 'rating', 'timestamp'])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ── User Progress and Profile ─────────────────────────────────────
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && validUserCreate();
      allow update: if isOwner(userId) && validUserUpdate();
      allow delete: if isAdmin();

      match /chatHistory/{chatId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && validChatHistory();
      }
    }

    // ── Students Collection ───────────────────────────────────────────────────
    match /students/{userId} {
      allow read: if isOwner(userId) || isTeacherOfStudent(resource) || isAdmin();
      allow create: if isOwner(userId) && validStudentCreate();
      allow update: if isOwner(userId) && validStudentUpdate();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // ── Classes Collection ───────────────────────────────────────────────────
    match /classes/{classId} {
      allow read: if isAuthenticated()
                  && (resource.data.teacherId == request.auth.uid
                      || request.auth.uid in resource.data.studentIds);
      allow write: if false; // Admin SDK only
    }

    // ── Duels / Real-time Multiplayer ─────────────────────────────────────────
    match /duels/{matchId} {
      allow read: if isAuthenticated()
                  && (resource.data.status == 'waiting'
                      || resource.data.player1.uid == request.auth.uid
                      || ('player2' in resource.data && resource.data.player2.uid == request.auth.uid));

      allow create: if isAuthenticated()
                    && request.resource.data.player1.uid == request.auth.uid
                    && request.resource.data.status == 'waiting'
                    && !('player2' in request.resource.data)
                    && request.resource.data.player1.score == 0
                    && request.resource.data.player1.finished == false;

      allow update: if isAuthenticated()
                    && (isJoiningDuel() || isParticipantUpdate());
    }

    // ─── Duel Helper Functions ──────────────────────────────────────
    function isJoiningDuel() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.status == 'waiting'
          && !('player2' in resource.data)
          && request.resource.data.status == 'playing'
          && request.resource.data.player2.uid == request.auth.uid
          && request.resource.data.player1.uid != request.auth.uid
          && request.resource.data.player2.score == 0
          && request.resource.data.player2.finished == false
          && request.resource.data.player1 == resource.data.player1
          && affected.hasOnly(['player2', 'status']);
    }

    function isParticipantUpdate() {
      return isPlayer1Update() || isPlayer2Update();
    }

    function isPlayer1Update() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return resource.data.player1.uid == request.auth.uid
          && affected.hasOnly(['player1', 'status'])
          && (!('player2' in resource.data) || request.resource.data.player2 == resource.data.player2)
          && request.resource.data.player1.uid == resource.data.player1.uid
          && request.resource.data.player1.displayName == resource.data.player1.displayName
          // Scores can ONLY be updated server-authoritatively
          && request.resource.data.player1.score == resource.data.player1.score
          && (request.resource.data.status == resource.data.status
              || (request.resource.data.status == 'finished'
                  && request.resource.data.player1.finished == true
                  && 'player2' in resource.data
                  && resource.data.player2.finished == true));
    }

    function isPlayer2Update() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return 'player2' in resource.data
          && resource.data.player2.uid == request.auth.uid
          && affected.hasOnly(['player2', 'status'])
          && request.resource.data.player1 == resource.data.player1
          && request.resource.data.player2.uid == resource.data.player2.uid
          && request.resource.data.player2.displayName == resource.data.player2.displayName
          // Scores can ONLY be updated server-authoritatively
          && request.resource.data.player2.score == resource.data.player2.score
          && (request.resource.data.status == resource.data.status
              || (request.resource.data.status == 'finished'
                  && request.resource.data.player2.finished == true
                  && resource.data.player1.finished == true));
    }

    // ── Public Content (curriculum data — read only) ──────────────────────────
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if false;
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Quiz Results ──────────────────────────────────────────────────────────
    match /quiz_results/{resultId} {
      allow read: if isAuthenticated()
                  && (request.auth.uid == resource.data.uid || isAdmin());
      // Authoritative only: Client writes forbidden
      allow write: if false;
    }

    // ── Teachers Collection ───────────────────────────────────────────────────
    match /teachers/{teacherId} {
      allow read: if isOwner(teacherId) || isAdmin();
      allow write: if false; // Set only via Admin SDK
    }

    // Implicit DENY ALL for all unmatched paths (Firestore default)
  }
}
